# =============================================================================
# PeopleDesk – environment configuration
# Copy to .env for local development:  cp .env.example .env
# On EC2 these values live in /etc/employee-management/app.env (see deployment/).
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Set to false to skip the EC2 instance metadata lookup (shown in the UI)
EC2_METADATA_ENABLED=true

# --- Database: local mode ----------------------------------------------------
# Used when AWS_SECRET_NAME is empty. Also used as fallbacks for fields that
# are missing from the Secrets Manager secret (e.g. DB_HOST for RDS-managed secrets).
# For Aurora, DB_HOST must be the CLUSTER (writer) endpoint, never an instance endpoint:
#   my-cluster.cluster-xxxxxxxxxxxx.eu-central-1.rds.amazonaws.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change-me-locally
DB_NAME=employee_management

# TLS to Aurora (recommended in AWS). Uses mysql2's bundled "Amazon RDS" CA
# profile unless DB_SSL_CA_PATH points to the RDS global-bundle.pem.
DB_SSL=false
DB_SSL_CA_PATH=

# --- Connection pool / resilience --------------------------------------------
DB_POOL_SIZE=10
DB_POOL_MAX_IDLE=5
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_RETRIES=3
DB_RETRY_BASE_DELAY_MS=250
DB_READY_TIMEOUT_MS=3000

# --- AWS deployment mode -----------------------------------------------------
# When AWS_SECRET_NAME is set, credentials are loaded from AWS Secrets Manager
# using the EC2 instance IAM role. Never put AWS access keys in this file.
AWS_REGION=eu-central-1
AWS_SECRET_NAME=
